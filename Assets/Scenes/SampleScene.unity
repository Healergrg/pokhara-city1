    timeLimitSeconds: 0
    averageSpeedKmh: 15
    passScore: 80
  - title: 'Hospital trip: CIWEC Hospital'
    description: Take a passenger to the hospital. Be quick but safe, and no horn
      at the end.
    start: {x: 851.1106, y: 0, z: -477.9901}
    via: []
    finish: {x: -385.344, y: 0, z: 505.06894}
    timeLimitSeconds: 0
    averageSpeedKmh: 27
    passScore: 70
  - title: Chowk challenge
